#!/bin/sh
# Resolve the installed prefix, including when validating a package in a test root.
set -eu
app_prefix=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")/../.." && pwd)
app_root="$app_prefix/opt/classic-price-lens"
cd -- "$app_root"
export QT_MEDIA_BACKEND=ffmpeg
export RAYON_NUM_THREADS=2
export OMP_NUM_THREADS=2
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
exec "$app_root/runtime/bin/python3" -m price_lens "$@"
